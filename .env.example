# JARVIS - Umgebungsvariablen
#
# Kopiere diese Datei nach ".env" und trage deine Keys ein.
# Sicherer ist der Windows Credential Manager - dann bleibt diese Datei leer:
#     jarvis secrets set ANTHROPIC_API_KEY
#
# Reihenfolge beim Lesen: echte Umgebungsvariable > .env > Credential Manager.
# Ein hier eingetragener Wert ueberdeckt also einen Key im Credential Manager.

ANTHROPIC_API_KEY=

# Ab Phase 3:
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Ab Phase 6:
# ELEVENLABS_API_KEY=

# Optional: anderen Datenordner verwenden (Standard: %LOCALAPPDATA%\Jarvis)
# JARVIS_DATA_DIR=D:\JarvisDaten
